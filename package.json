{
  "name": "globaleye",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para seleccionar un área de la pantalla, realizar OCR y traducir el texto.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "keywords": [
    "ocr",
    "translate",
    "screen",
    "electron"
  ],
  "author": "David González",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.0.0",
    "electron-overlay-window": "^3.0.0",
    "sharp": "^0.34.1",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.davilex.globaleye",
    "productName": "GlobalEye",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "screenSelector.js",
      "selectionPreload.js",
      "overlay.js",
      "overlay.html",
      "overlayPreload.js",
      "overlayRenderer.js",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
